{
  "manifest_version": 3,
  "name": "BCPアラート（分離版）",
  "version": "1.0.5",
  "description": "テン・メモからBCP機能のみを分離した単独版。v1.0.5で機能を維持したまま構成を6ファイルへ統合・簡素化。",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.jma.go.jp/*",
    "https://www.data.jma.go.jp/*"
  ],
  "icons": {
    "48": "icon48.png"
  },
  "action": {
    "default_title": "BCPアラート",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
