{
  "manifest_version": 3,
  "name": "警報お知らせくん",
  "version": "1.0.15",
  "description": "気象警報Tabは新規の警報以上または警報レベル上昇時だけ赤点滅し、注意報・同レベル更新・解除・注意報への低下では点滅しない。地震・台風の未読判定は従来どおり。",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.jma.go.jp/*",
    "https://www.data.jma.go.jp/*"
  ],
  "icons": {
    "48": "icon48.png"
  },
  "action": {
    "default_title": "警報お知らせくん",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background_entry.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
