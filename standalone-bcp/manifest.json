{
  "manifest_version": 3,
  "name": "BCPアラート（分離版）",
  "version": "1.0.9",
  "description": "BCP分離版。v1.0.9でTab未読表示を2段階化。新規事象・警戒レベル/勢力上昇は赤、同レベルの情報更新は黄色で発光し、黄色未読中に赤対象が来た場合は赤へ昇格。",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.jma.go.jp/*",
    "https://www.data.jma.go.jp/*"
  ],
  "icons": {
    "48": "icon48.png"
  },
  "action": {
    "default_title": "BCPアラート",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
