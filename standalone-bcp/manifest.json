{
  "manifest_version": 3,
  "name": "BCPアラート（分離版）",
  "version": "1.0.8",
  "description": "BCP分離版。v1.0.8で自動更新ON/OFF切替時の「保存中」表示を廃止し、スイッチが即座に自然に切り替わるよう改善。",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.jma.go.jp/*",
    "https://www.data.jma.go.jp/*"
  ],
  "icons": {
    "48": "icon48.png"
  },
  "action": {
    "default_title": "BCPアラート",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
